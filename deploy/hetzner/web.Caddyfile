{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip
	@backend path /api/* /socket.io/* /health
	handle @backend {
		reverse_proxy balaio_api:3333
	}
	handle {
		root * /srv
		@nocache path /sw.js /index.html /manifest.webmanifest
		header @nocache Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
